<UserControl x:Class="NetFlixApp.VISTA.LlistaPeliculesUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NetFlixApp.VISTA"
             mc:Ignorable="d" 
             d:DesignWidth="700"
             d:DesignHeight="400"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Títol -->
            <RowDefinition Height="Auto"/>
            <!-- Filtre -->
            <RowDefinition Height="Auto"/>
            <!-- DataGrid -->
            <RowDefinition Height="*"/>
            <!-- Resultat -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TÍTOL -->
        <TextBlock Grid.Row="0"
                   Text="Buscar pel·lícules per Gènere"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- FILTRE -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,15">

            <TextBlock Text="Index:"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <TextBox x:Name="TxtIndex"
                     Width="60"
                     Height="30"
                     Margin="0,0,10,0"
                     FontSize="14"
                     VerticalContentAlignment="Center"/>

            <TextBlock Text="Llargada:"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <TextBox x:Name="TxtLargada"
                     Width="60"
                     Height="30"
                     Margin="0,0,10,0"
                     FontSize="14"
                     VerticalContentAlignment="Center"/>

            <Button x:Name="BtnIndexLlargada" Content="Buscar"
                    Width="50"
                    Height="30" Click="BtnIndexLlargada_Click"/>

        </StackPanel>

        <!-- RESULTATS -->
        <DataGrid x:Name="DgPelicules"
          Grid.Row="2"
          AutoGenerateColumns="True"
          IsReadOnly="True"
          CanUserAddRows="False"/>


    </Grid>
</UserControl>


<UserControl x:Class="NetFlixApp.VISTA.FitxerArrayOrdenatUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NetFlixApp.VISTA"
             mc:Ignorable="d" 
             d:DesignWidth="700"
             d:DesignHeight="400"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Títol -->
            <RowDefinition Height="Auto"/>
            <!-- Filtre -->
            <RowDefinition Height="Auto"/>
            <!-- Radiobutton -->
            <RowDefinition Height="Auto"/>
            <!-- Resultat -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TÍTOL -->
        <TextBlock Grid.Row="0"
                   Text="Guarda les pel·lícules en un fitxer ordenat"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- FILTRE -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,15">

            <TextBlock Text="Index:"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <TextBox x:Name="TxtIndex"
                     Width="60"
                     Height="30"
                     Margin="0,0,10,0"
                     FontSize="14"
                     VerticalContentAlignment="Center"/>

            <TextBlock Text="Llargada:"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <TextBox x:Name="TxtLargada"
                     Width="60"
                     Height="30"
                     Margin="0,0,10,0"
                     FontSize="14"
                     VerticalContentAlignment="Center"/>
            <TextBlock Text="Fitxer Sortida:"
           VerticalAlignment="Center"
           Margin="0,0,10,0"/>

            <TextBox x:Name="TxtFitxerSortida"
         Width="150"
         Height="30"
         Margin="0,0,10,0"
         FontSize="14"
         VerticalContentAlignment="Center"/>

            <Button x:Name="BtnGuardarFitxer" Content="Guardar"
                    Width="50"
                    Height="30" Click="BtnGuardarFitxer_Click"/>

        </StackPanel>
        <!-- OPCIONS DE VISUALITZACIÓ -->

        <Border Grid.Row="2"
        Background="#F5F5F5"
        BorderBrush="#D0D0D0"
        BorderThickness="1"
        Padding="12"
        Margin="0,0,0,10">

            <StackPanel Orientation="Vertical">

                <TextBlock Text="Visualitzar fitxer amb:"
                   FontWeight="Bold"
                   Margin="0,0,0,8"/>

                <RadioButton x:Name="RbEditor"
                     Content="Editor per defecte"
                     IsChecked="True"
                     Margin="5,2"/>

                <RadioButton x:Name="RbNotepad"
                     Content="Notepad"
                     Margin="5,2"/>

                <RadioButton x:Name="RbCsv"
                     Content="Visor CSV"
                     Margin="5,2"/>

            </StackPanel>

        </Border>


        <!-- INFORMACIÓN -->
        <Border Grid.Row="3"
                Padding="10"
                Background="#F0F0F0"
                BorderBrush="#D0D0D0"
                BorderThickness="1">

            <TextBlock x:Name="TxtResultat"
                       Text="Selecciona un index inicial i final i un nom de fitxer per guardar les pel·lícules."
                       FontSize="14"
                       FontWeight="SemiBold"/>

        </Border>

    </Grid>
</UserControl>

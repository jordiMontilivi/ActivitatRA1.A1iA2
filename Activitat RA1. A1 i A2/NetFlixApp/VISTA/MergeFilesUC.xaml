<UserControl x:Class="NetFlixApp.VISTA.MergeFilesUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NetFlixApp.VISTA"
             mc:Ignorable="d" 
             d:DesignWidth="700"
             d:DesignHeight="400"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- TÍTOL -->

        <TextBlock Grid.Row="0"
                Text="Fusionar fitxers de pel·lícules"
                FontSize="22"
                FontWeight="Bold"
                Margin="0,0,0,15"/>


        <!-- FITXER 1 -->

        <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                Margin="0,0,0,8">

            <TextBlock Text="Fitxer 1:"
                    Width="80"
                    VerticalAlignment="Center"/>

            <TextBox x:Name="TxtFitxer1"
                    Width="280"
                    Height="26"
                    IsReadOnly="True"
                    VerticalContentAlignment="Center"/>

            <Button Content="..."
                Width="30"
                Height="26"
                Margin="5,0,0,0"
                Click="BtnFitxer1_Click"/>

        </StackPanel>


        <!-- FITXER 2 -->

        <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                Margin="0,0,0,8">

            <TextBlock Text="Fitxer 2:"
                    Width="80"
                    VerticalAlignment="Center"/>

            <TextBox x:Name="TxtFitxer2"
                    Width="280"
                    Height="26"
                    IsReadOnly="True"
                    VerticalContentAlignment="Center"/>

            <Button Content="..."
                Width="30"
                Height="26"
                Margin="5,0,0,0"
                Click="BtnFitxer2_Click"/>

        </StackPanel>


        <!-- FITXER SORTIDA -->

        <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                Margin="0,0,0,10">

            <TextBlock Text="Fitxer sortida:"
                    Width="80"
                    VerticalAlignment="Center"/>

            <TextBox x:Name="TxtFitxerSortida"
                    Width="280"
                    Height="26"
                    VerticalContentAlignment="Center"/>

            <Button Content="..."
                Width="30"
                Height="26"
                Margin="5,0,0,0"
                Click="BtnFitxerSortida_Click"/>

        </StackPanel>


        <!-- OPCIONS DE VISUALITZACIÓ -->

        <Border Grid.Row="4"
            Background="#F5F5F5"
            BorderBrush="#D0D0D0"
            BorderThickness="1"
            Padding="8"
            Margin="0,0,0,10">

            <StackPanel Orientation="Horizontal">

                <TextBlock Text="Visualitzar amb:"
                        FontWeight="Bold"
                        VerticalAlignment="Center"
                        Margin="0,0,15,0"/>

                <RadioButton x:Name="RbEditor"
                            Content="Editor per defecte"
                            IsChecked="True"
                            VerticalAlignment="Center"
                            Margin="0,0,15,0"/>

                <RadioButton x:Name="RbNotepad"
                            Content="Notepad"
                            VerticalAlignment="Center"
                            Margin="0,0,15,0"/>

                <RadioButton x:Name="RbCsv"
                            Content="Visor CSV"
                            VerticalAlignment="Center"/>

            </StackPanel>

        </Border>


        <!-- BOTÓ FUSIONAR -->

        <Button Grid.Row="5"
            x:Name="BtnFusionar"
            Content="FUSIONAR FITXERS"
            Width="140"
            Height="32"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="BtnFusionar_Click"/>


        <!-- RESULTAT -->

        <Border Grid.Row="6"
            Margin="0,10,0,0"
            Padding="8"
            Background="#F0F0F0"
            BorderBrush="#D0D0D0"
            BorderThickness="1">

            <TextBlock x:Name="TxtResultat"
                    Text="Selecciona els dos fitxers d'entrada i el fitxer de sortida."
                    FontSize="13"
                    FontWeight="SemiBold"/>

        </Border>

    </Grid>

</UserControl>

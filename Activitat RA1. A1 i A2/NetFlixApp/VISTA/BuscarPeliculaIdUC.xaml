<UserControl x:Class="NetFlixApp.VISTA.BuscarPeliculaIdUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NetFlixApp.VISTA"
             mc:Ignorable="d" 
                          d:DesignWidth="700"
             d:DesignHeight="500"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- TÍTOL -->

        <TextBlock Grid.Row="0"
                   Text="Buscar pel·lícula per índex"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>


        <!-- CERCA -->

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,20">

            <TextBlock Text="Id:"
                       VerticalAlignment="Center"
                       FontSize="14"
                       Margin="0,0,10,0"/>

            <TextBox x:Name="TxtId"
                     Width="100"
                     Height="30"
                     Margin="0,0,10,0"
                     FontSize="14"
                     VerticalContentAlignment="Center"/>

            <Button Content="Buscar"
                    Width="70"
                    Height="30"
                    Click="BtnBuscar_Click"/>

        </StackPanel>

        <!-- DADES -->

        <Border Grid.Row="2"
        Background="#F5F5F5"
        BorderBrush="#D0D0D0"
        BorderThickness="1"
        Padding="8">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="65"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- FILA 0 -->

                <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Text="Index:"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="0,1"/>

                <TextBlock x:Name="TxtResultIndex"
                   Grid.Row="0"
                   Grid.Column="1"
                   VerticalAlignment="Center"
                   Margin="3,1"/>


                <TextBlock Grid.Row="0"
                   Grid.Column="2"
                   Text="ID:"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="5,1,0,1"/>

                <TextBlock x:Name="TxtResultId"
                   Grid.Row="0"
                   Grid.Column="3"
                   VerticalAlignment="Center"
                   Margin="3,1"/>


                <!-- FILA 1 -->

                <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Text="Títol:"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="0,1"/>

                <TextBlock x:Name="TxtResultTitle"
                   Grid.Row="1"
                   Grid.Column="1"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="3,1"/>


                <TextBlock Grid.Row="1"
                   Grid.Column="2"
                   Text="Tipus:"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="5,1,0,1"/>

                <TextBlock x:Name="TxtResultType"
                   Grid.Row="1"
                   Grid.Column="3"
                   VerticalAlignment="Center"
                   Margin="3,1"/>


                <!-- FILA 2 -->

                <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   Text="Any:"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="0,1"/>

                <TextBlock x:Name="TxtResultYear"
                   Grid.Row="2"
                   Grid.Column="1"
                   VerticalAlignment="Center"
                   Margin="3,1"/>


                <TextBlock Grid.Row="2"
                   Grid.Column="2"
                   Text="Certificació:"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="5,1,0,1"/>

                <TextBlock x:Name="TxtResultCertification"
                   Grid.Row="2"
                   Grid.Column="3"
                   VerticalAlignment="Center"
                   Margin="3,1"/>


                <!-- FILA 3 -->

                <TextBlock Grid.Row="3"
                   Grid.Column="0"
                   Text="Durada:"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="0,1"/>

                <TextBlock x:Name="TxtResultRuntime"
                   Grid.Row="3"
                   Grid.Column="1"
                   VerticalAlignment="Center"
                   Margin="3,1"/>


                <TextBlock Grid.Row="3"
                   Grid.Column="2"
                   Text="Gèneres:"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="5,1,0,1"/>

                <TextBlock x:Name="TxtResultGenres"
                   Grid.Row="3"
                   Grid.Column="3"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="3,1"/>


                <!-- FILA 4 -->

                <TextBlock Grid.Row="4"
                   Grid.Column="0"
                   Text="Països:"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="0,1"/>

                <TextBlock x:Name="TxtResultCountries"
                   Grid.Row="4"
                   Grid.Column="1"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="3,1"/>


                <TextBlock Grid.Row="4"
                   Grid.Column="2"
                   Text="Temporades:"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="5,1,0,1"/>

                <TextBlock x:Name="TxtResultSeasons"
                   Grid.Row="4"
                   Grid.Column="3"
                   VerticalAlignment="Center"
                   Margin="3,1"/>


                <!-- FILA 5 -->

                <TextBlock Grid.Row="5"
                   Grid.Column="0"
                   Text="IMDb ID:"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="0,1"/>

                <TextBlock x:Name="TxtResultImdbId"
                   Grid.Row="5"
                   Grid.Column="1"
                   VerticalAlignment="Center"
                   Margin="3,1"/>


                <TextBlock Grid.Row="5"
                   Grid.Column="2"
                   Text="Nota IMDb:"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="5,1,0,1"/>

                <TextBlock x:Name="TxtResultImdbScore"
                   Grid.Row="5"
                   Grid.Column="3"
                   VerticalAlignment="Center"
                   Margin="3,1"/>


                <!-- FILA 6 -->

                <TextBlock Grid.Row="6"
                   Grid.Column="0"
                   Text="Vots:"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="0,1"/>

                <TextBlock x:Name="TxtResultImdbVotes"
                   Grid.Row="6"
                   Grid.Column="1"
                   VerticalAlignment="Center"
                   Margin="3,1"/>

            </Grid>

        </Border>

    </Grid>
</UserControl>
